services:
  redis:
    image: {{ redis_image }}
    container_name: {{ redis_container_name }}
    restart: {{ redis_restart_policy }}
    ports:
      - "{{ redis_bind_address }}:{{ redis_port }}:6379"
    command:
      - redis-server
      - --appendonly
      - "{{ redis_appendonly }}"
{% if redis_password is defined and redis_password | length > 0 %}
      - --requirepass
      - "{{ redis_password }}"
{% endif %}
    volumes:
      - {{ redis_data_volume }}:/data
    healthcheck:
      test:
{% if redis_password is defined and redis_password | length > 0 %}
        - CMD
        - redis-cli
        - -a
        - "{{ redis_password }}"
        - ping
{% else %}
        - CMD
        - redis-cli
        - ping
{% endif %}
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 5s

volumes:
  {{ redis_data_volume }}:
